{{- /* 地点页内容适配器（Hugo 0.126+）：构建期从 data/locations.toml 生成 /footprint/<slug>/ 虚拟页面，
       不再需要手工维护 content/footprint/<slug>.md。locations.toml 预登记全部省级地区，
       只为照片实际使用的地点生成页面——预留但无照片的地区不产生空页（2026-11-15）。 */}}
{{- /* 照片数据已按拍摄年份拆分到 data/photos/：合并各分片（顺序无关，本适配器
       只收集 location 集合）。内容适配器在站点初始化完成前执行，不能调用
       含 site.GetPage 校验的 photo-sorted partial（2026-11-20） */}}
{{- $photos := slice }}
{{- range $name, $shard := hugo.Data.photos }}
    {{- with $shard.photo }}
        {{- range . }}{{ $photos = $photos | append . }}{{ end }}
    {{- end }}
{{- end }}
{{- $used := dict }}
{{- range $photos }}
    {{- with .location }}{{ $used = merge $used (dict . true) }}{{ end }}
{{- end }}
{{- $seen := dict }}
{{- $registered := dict }}
{{- range hugo.Data.locations.location }}
    {{- if not .slug }}{{ errorf "%s" (i18n "error_location_slug_missing" (dict "Name" (printf "%q" .name))) }}{{ end }}
    {{- if isset $seen .slug }}{{ errorf "%s" (i18n "error_location_slug_duplicate" (dict "Slug" (printf "%q" .slug))) }}{{ end }}
    {{- $seen = merge $seen (dict .slug true) }}
    {{- $registered = merge $registered (dict .name true) }}
    {{- if isset $used .name }}
        {{- $page := dict
            "kind" "page"
            "path" .slug
            "title" .name
            "params" (dict "description" "人世幾回傷往事，山形依舊枕寒流")
        }}
        {{- $.AddPage $page }}
    {{- end }}
{{- end }}
{{- /* 照片地点必须登记：未登记时足迹聚合仍收录并回退 urlize URL，但地点页不存在
       （时间线/地图点击 404）——构建期报错，宁可失败也不发布死链 */}}
{{- $missing := slice }}
{{- range $photos }}
    {{- with .location }}
        {{- if and (not (isset $registered .)) (not (in $missing .)) }}
            {{- $missing = $missing | append . }}
        {{- end }}
    {{- end }}
{{- end }}
{{- with $missing }}
    {{- errorf "%s" (i18n "error_location_unregistered" (dict "Names" (delimit . (i18n "error_list_separator")))) }}
{{- end }}

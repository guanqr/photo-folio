{{- /* 摄影作品订阅源（RSS 2.0，/index.xml）：每张作品一条，按发布时间倒序，
       只输出最近 feedCount 条（hugo.toml [params].feedCount，默认 20）。
       published 由管线在条目首次写入时记录，旧数据缺该字段时回退拍摄时间。
       GUID 用作品 src（稳定唯一）——此前按拍摄日期分组、GUID=日期，已有日期
       或早于最近 20 天窗口的新作品永远不会成为新条目，订阅器收不到更新
       （2026-11-12）。 */ -}}
{{- $feedCount := site.Params.feedCount | default 20 -}}
{{- $sorted := partialCached "utils/photo-sorted.html" . "desc" -}}
{{- /* 排序键 = 发布时间 Unix 秒 + 拍摄时间：整数/字符串比较，避免模板 sort
       直接比较 time 类型；同批次内按拍摄时间降序保持稳定 */ -}}
{{- $entries := slice -}}
{{- range $sorted -}}
    {{- $at := .time | time.AsTime -}}
    {{- with .published -}}
        {{- $at = . | time.AsTime -}}
    {{- end -}}
    {{- $key := printf "%020d|%s" $at.Unix .time -}}
    {{- $entries = $entries | append (dict "photo" . "at" $at "key" $key) -}}
{{- end -}}
{{- $entries = sort $entries "key" "desc" -}}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
    <title>{{ site.Title | transform.XMLEscape }}</title>
    <link>{{ site.Home.Permalink }}</link>
    <description>{{ i18n "feed_description" | transform.XMLEscape }}</description>
    <language>{{ site.Language.Lang }}</language>
    <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
    <atom:link href="{{ "index.xml" | absURL }}" rel="self" type="application/rss+xml" />
    {{- range first $feedCount $entries -}}
        {{- $p := .photo -}}
        {{- $slug := $p.src | path.Base | strings.TrimSuffix (path.Ext $p.src) -}}
        {{- /* 展示文本一律走 i18n；空标题回退 i18n 占位 */ -}}
        {{- $title := $p.alt | default (i18n "feed_untitled") -}}
        {{- $desc := i18n "feed_photo_meta" (dict "Place" (default $p.location $p.place) "Date" $p.time) -}}
    <item>
        <title>{{ $title | transform.XMLEscape }}</title>
        <link>{{ printf "%sgallery/?p=%s" site.Home.Permalink ($slug | urlquery) }}</link>
        <guid isPermaLink="false">{{ $p.src | transform.XMLEscape }}</guid>
        <pubDate>{{ .at.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
        <description>{{ $desc | transform.XMLEscape }}</description>
    </item>
    {{- end -}}
</channel>
</rss>
